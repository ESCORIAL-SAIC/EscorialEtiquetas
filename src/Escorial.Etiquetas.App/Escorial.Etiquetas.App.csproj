<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Escorial.Etiquetas.App</RootNamespace>
    <AssemblyName>EscorialEtiquetas</AssemblyName>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Escorial.Etiquetas.Core\Escorial.Etiquetas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Escorial.Etiquetas.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- secrets.local.xml junto al ejecutable si existe en la carpeta del proyecto (nunca se versiona) -->
    <None Include="secrets.local.xml" Condition="Exists('secrets.local.xml')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

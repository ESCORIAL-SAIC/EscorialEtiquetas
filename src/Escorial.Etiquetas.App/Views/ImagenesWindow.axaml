<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Escorial.Etiquetas.App.ViewModels"
        x:Class="Escorial.Etiquetas.App.Views.ImagenesWindow"
        x:DataType="vm:ImagenesViewModel"
        Title="Imágenes de modelos"
        Icon="/Assets/favicon.ico"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <ComboBox Grid.Row="0" HorizontalAlignment="Stretch" FontSize="18"
              ItemsSource="{Binding Modelos}" SelectedItem="{Binding ModeloSeleccionado}" />
    <Grid Grid.Row="1" ColumnDefinitions="*,8,Auto">
      <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding Ruta}" Watermark="Archivo JPG o PNG" />
      <Button Grid.Column="2" Content="Examinar" Command="{Binding ExaminarCommand}" />
    </Grid>
    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="4">
      <Image Source="{Binding VistaPrevia, Converter={StaticResource BytesToBitmap}}" Stretch="Uniform" />
    </Border>
    <Button Grid.Row="3" Classes="primario" Content="Confirmar" Command="{Binding ConfirmarCommand}" />
  </Grid>
</Window>

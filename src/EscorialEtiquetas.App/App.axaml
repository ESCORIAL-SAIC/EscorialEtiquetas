<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EscorialEtiquetas.App.Views"
             x:Class="EscorialEtiquetas.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <views:BytesToBitmapConverter x:Key="BytesToBitmap" />
    <SolidColorBrush x:Key="Acento" Color="#5581F4" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.primario">
      <Setter Property="Background" Value="{StaticResource Acento}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primario:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3F6BE0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
